{{ 'section-editorial-split.css' | asset_url | stylesheet_tag }}

<section
  id="EditorialSplit-{{ section.id }}"
  class="lx-split{% if section.settings.image_position == 'right' %} lx-split--reversed{% endif %}"
>
  <div class="lx-split__container">
    <div class="lx-split__media">
      {%- if section.settings.main_image != blank -%}
        {{
          section.settings.main_image
          | image_url: width: 1600
          | image_tag:
            widths: '550, 750, 1100, 1600',
            sizes: '(min-width: 990px) 55vw, 100vw',
            loading: 'lazy',
            decoding: 'async',
            class: 'lx-split__img',
            alt: section.settings.main_image.alt | default: section.settings.heading | escape
        }}
      {%- else -%}
        <img
          src="{{ 'solen-split-studio.jpg' | asset_url }}"
          alt="{{ section.settings.heading | default: 'SOLEN Atelier Philosophy' | escape }}"
          class="lx-split__img"
          loading="lazy"
          decoding="async"
          width="1200"
          height="1600"
        >
      {%- endif -%}
    </div>

    <div class="lx-split__content">
      <div class="lx-split__narrative">
        {%- if section.settings.eyebrow != blank -%}
          <span class="lx-eyebrow lx-eyebrow--with-bar">
            {{ section.settings.eyebrow | escape }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="lx-split__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        <div class="lx-split__body">
          {%- if section.settings.paragraph_1 != blank -%}
            <p>{{ section.settings.paragraph_1 | escape }}</p>
          {%- endif -%}
          {%- if section.settings.paragraph_2 != blank -%}
            <p>{{ section.settings.paragraph_2 | escape }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.inset_title != blank or section.settings.inset_copy != blank or section.settings.inset_image != blank -%}
        <div class="lx-split__inset">
          <div class="lx-split__inset-media">
            {%- if section.settings.inset_image != blank -%}
              {{
                section.settings.inset_image
                | image_url: width: 320
                | image_tag:
                  widths: '112, 224, 320',
                  sizes: '112px',
                  loading: 'lazy',
                  decoding: 'async',
                  class: 'lx-split__inset-img',
                  alt: section.settings.inset_image.alt | default: section.settings.inset_title | escape
              }}
            {%- else -%}
              <img
                src="{{ 'solen-material-inset.jpg' | asset_url }}"
                alt="{{ section.settings.inset_title | default: 'Mortise and Bronze Inlay' | escape }}"
                class="lx-split__inset-img"
                loading="lazy"
                decoding="async"
                width="320"
                height="320"
              >
            {%- endif -%}
          </div>

          <div class="lx-split__inset-text">
            {%- if section.settings.inset_title != blank -%}
              <h3 class="lx-split__inset-title">{{ section.settings.inset_title | escape }}</h3>
            {%- endif -%}
            {%- if section.settings.inset_copy != blank -%}
              <p class="lx-split__inset-copy">{{ section.settings.inset_copy | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial Split",
  "tag": "section",
  "class": "section-editorial-split",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "options": [
        {
          "value": "left",
          "label": "Left (55% / 45%)"
        },
        {
          "value": "right",
          "label": "Right (45% / 55%)"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main studio photograph"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ATELIER PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered for Posture, Shaped by Hand."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "First paragraph",
      "default": "Every SOLEN piece begins as an architectural elevation. We balance precision ergonomic support with quiet timber joinery so the workspace feels restorative rather than mechanical."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Second paragraph",
      "default": "Crafted in small numbered runs from kiln-dried European oak, natural linen bouclé, and hand-patinated bronze hardware designed to age gracefully over decades."
    },
    {
      "type": "header",
      "content": "Material detail inset"
    },
    {
      "type": "image_picker",
      "id": "inset_image",
      "label": "Square detail image (112x112)"
    },
    {
      "type": "text",
      "id": "inset_title",
      "label": "Material title",
      "default": "Mortise & Bronze Inlay"
    },
    {
      "type": "textarea",
      "id": "inset_copy",
      "label": "Material description",
      "default": "Hand-rubbed linseed oak paired with undyed Belgian bouclé."
    }
  ],
  "presets": [
    {
      "name": "Editorial Split"
    }
  ]
}
{% endschema %}
